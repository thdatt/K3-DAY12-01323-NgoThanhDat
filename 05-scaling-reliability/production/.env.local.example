# ============================================================
# Mau cho file .env.local
#
# docker-compose.yml khai bao "env_file: - .env.local".
# File .env.local that bi .gitignore chan (vi chua secret), nen sau khi
# clone repo ve BAT BUOC phai tu tao, neu khong "docker compose up" se loi:
#     env file .env.local not found
#
# Cach dung:
#     copy .env.local.example .env.local        (Windows)
#     cp   .env.local.example .env.local        (Linux/macOS)
# ============================================================

OPENAI_API_KEY=
AGENT_API_KEY=day12-scaling-dev-key
LOG_LEVEL=INFO
