# Copy file nay thanh .env roi dien gia tri that
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux/macOS)
#
# KHONG BAO GIO commit file .env len Git.

# Bat buoc - app se CHET NGAY neu de trong hoac de placeholder (fail-fast).
# Sinh chuoi ngau nhien: python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_API_KEY=

# Server
PORT=8000
LOG_LEVEL=INFO

# Redis
#   Chay local (khong Docker): redis://localhost:6379/0
#   Chay bang docker compose:  redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Gioi han
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# Dat true neu khong deploy duoc len cloud (toi da 9/15 diem cho CP5)
LOCAL_FALLBACK=false
